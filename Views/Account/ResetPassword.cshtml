@model Authenticate.Models.ResetPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reset Password";
}
<div class="container">
    <div class="row">
        <div class="col-md-6 col-lg-5 mx-auto">
            <div class="text-center mb-4">
                <h1 class="h3 mb-1">Reset password</h1>
                <p class="text-muted">Choose a new password for your account.</p>
            </div>

            @Html.ValidationSummary("", new { @class = "text-danger" })

            <form method="post" action="/Account/ResetPassword" class="card p-3 shadow-sm">
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.Token)

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password", required = "required" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", required = "required" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-primary w-100">Reset password</button>

                <div class="text-center mt-3">
                    <a class="small" href="/Account/Login">Back to sign in</a>
                </div>
            </form>
        </div>
    </div>
</div>