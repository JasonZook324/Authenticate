@model Authenticate.Models.ForgotPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot Password";
}
<div class="container">
    <div class="row">
        <div class="col-md-6 col-lg-5 mx-auto">
            <div class="text-center mb-4">
                <h1 class="h3 mb-1">Forgot password</h1>
                <p class="text-muted">Enter your email to receive a reset link.</p>
            </div>

            @if (TempData["Message"] is string toast)
            {
                var cls = (TempData["MessageClass"] as string) ?? "alert-info";
                <div class="alert @cls" role="alert">@toast</div>
            }

            @Html.ValidationSummary("", new { @class = "text-danger" })

            <form method="post" action="/Account/ForgotPassword" class="card p-3 shadow-sm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "email", required = "required" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-primary w-100">Send reset link</button>

                <div class="text-center mt-3">
                    <a class="small" href="/Account/Login">Back to sign in</a>
                </div>
            </form>
        </div>
    </div>
</div>