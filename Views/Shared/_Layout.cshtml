@using Microsoft.EntityFrameworkCore
@inject Authenticate.Data.ApplicationDbContext Db
@{
    Layout = null;
    List<Authenticate.Data.Entities.Menu>? menus = null;
    try
    {
        menus = await Db.Menus
            .Where(m => m.IsActive)
            .OrderBy(m => m.Weight)
            .ToListAsync();
    }
    catch (Exception)
    {
        menus = new List<Authenticate.Data.Entities.Menu>();
    }

    var leftMenus = menus?.Where(m => m.Weight < 0).ToList() ?? new List<Authenticate.Data.Entities.Menu>();
    var centerMenus = menus?.Where(m => m.Weight == 0).ToList() ?? new List<Authenticate.Data.Entities.Menu>();
    var rightMenus = menus?.Where(m => m.Weight > 0).ToList() ?? new List<Authenticate.Data.Entities.Menu>();
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = isAuth && User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MyApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        /* Center the zero-weight menu(s) exactly in the navbar on lg+ screens */
        @@media (min-width: 992px) {
            .navbar .container,
            .navbar .container-fluid {
                position: relative;
            }
            .navbar-nav-center {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
            }
        }

        /* Global busy overlay */
        .busy-overlay {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,0.7);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }
        .busy-overlay.show { display: flex; }
        .busy-box {
            background: #fff;
            border-radius: .5rem;
            padding: 1rem 1.25rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
            display: flex;
            align-items: center;
            gap: .75rem;
        }
        .busy-text { font-weight: 500; }
        body.busy { cursor: progress; }
    </style>
</head>
<body>
    <!-- Busy overlay -->
    <div id="busy-overlay" class="busy-overlay" aria-hidden="true" aria-live="polite" aria-busy="false">
        <div class="busy-box">
            <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
            <div id="busy-text" class="busy-text">Working…</div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">MyApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Left menus -->
                <ul class="navbar-nav">
                    @foreach (var item in leftMenus)
                    {
                        var name = item.Name ?? string.Empty;
                        var target = item.Target ?? string.Empty;

                        if (name.Equals("Logout", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAuth)
                            {
                                <li class="nav-item">
                                    <form method="post" action="@target" class="d-inline" data-busy="Signing out…">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link nav-link p-0">@(name)</button>
                                    </form>
                                </li>
                            }
                        }
                        else if (name.Equals("Login", StringComparison.OrdinalIgnoreCase))
                        {
                            if (!isAuth)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else if (name.Equals("Account", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAuth)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else if (name.Equals("Dashboard", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAuth && !isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else if (name.Equals("Admin", StringComparison.OrdinalIgnoreCase) || name.Equals("Admin Dashboard", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else if (name.Equals("API Credential Manager", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAuth)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                        }
                    }
                </ul>

                <!-- Center menus -->
                @if (centerMenus.Count > 0)
                {
                    <ul class="navbar-nav navbar-nav-center">
                        @foreach (var item in centerMenus)
                        {
                            var name = item.Name ?? string.Empty;
                            var target = item.Target ?? string.Empty;

                            if (name.Equals("Logout", StringComparison.OrdinalIgnoreCase))
                            {
                                if (isAuth)
                                {
                                    <li class="nav-item">
                                        <form method="post" action="@target" class="d-inline" data-busy="Signing out…">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-link nav-link p-0">@name</button>
                                        </form>
                                    </li>
                                }
                            }
                            else if (name.Equals("Login", StringComparison.OrdinalIgnoreCase))
                            {
                                if (!isAuth)
                                {
                                    <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                                }
                            }
                            else if (name.Equals("Account", StringComparison.OrdinalIgnoreCase))
                            {
                                if (isAuth)
                                {
                                    <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                                }
                            }
                            else if (name.Equals("Dashboard", StringComparison.OrdinalIgnoreCase))
                            {
                                if (isAuth && !isAdmin)
                                {
                                    <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                                }
                            }
                            else if (name.Equals("Admin", StringComparison.OrdinalIgnoreCase) || name.Equals("Admin Dashboard", StringComparison.OrdinalIgnoreCase))
                            {
                                if (isAdmin)
                                {
                                    <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                                }
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                    </ul>
                }

                <!-- Right menus -->
                <ul class="navbar-nav ms-auto">
                    @foreach (var item in rightMenus)
                    {
                        var name = item.Name ?? string.Empty;
                        var target = item.Target ?? string.Empty;

                        if (name.Equals("Logout", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAuth)
                            {
                                <li class="nav-item">
                                    <form method="post" action="@target" class="d-inline" data-busy="Signing out…">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link nav-link p-0">@name</button>
                                    </form>
                                </li>
                            }
                        }
                        else if (name.Equals("Login", StringComparison.OrdinalIgnoreCase))
                        {
                            if (!isAuth)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else if (name.Equals("Account", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAuth)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else if (name.Equals("Dashboard", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAuth && !isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else if (name.Equals("Admin", StringComparison.OrdinalIgnoreCase) || name.Equals("Admin Dashboard", StringComparison.OrdinalIgnoreCase))
                        {
                            if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                            }
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="@target">@name</a></li>
                        }
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>
    <footer class="bg-light text-center py-3 mt-4">
        <span class="text-muted">&copy; @DateTime.Now.Year - MyApp</span>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    (() => {
      const overlay = document.getElementById('busy-overlay');
      const text = document.getElementById('busy-text');

      function showBusy(message) {
        text.textContent = message || 'Working…';
        overlay.classList.add('show');
        overlay.setAttribute('aria-busy', 'true');
        document.body.classList.add('busy');
      }
      function hideBusy() {
        overlay.classList.remove('show');
        overlay.setAttribute('aria-busy', 'false');
        document.body.classList.remove('busy');
      }
      // Expose for optional manual use
      window.AppBusy = { show: showBusy, hide: hideBusy };

      // Show on any form submit; customize with data-busy="Your message…"
      document.addEventListener('submit', (e) => {
        const form = e.target;
        if (!(form instanceof HTMLFormElement)) return;
        const msg = form.getAttribute('data-busy') || 'Working…';
        showBusy(msg);
        // prevent double submit
        form.querySelectorAll('button[type=submit],input[type=submit]').forEach(btn => btn.setAttribute('disabled', 'disabled'));
      });

      // Optional: show when leaving page for navigations
      window.addEventListener('beforeunload', () => {
        showBusy('Loading…');
      });

      // Elements with data-busy (e.g., links or buttons) trigger overlay on click
      document.addEventListener('click', (e) => {
        const el = e.target.closest('[data-busy-click]');
        if (!el) return;
        const msg = el.getAttribute('data-busy-click') || 'Working…';
        showBusy(msg);
      });
    })();
    </script>
</body>
</html>