@using Microsoft.EntityFrameworkCore
@inject Authenticate.Data.ApplicationDbContext Db
@{
    Layout = null;
    List<Authenticate.Data.Entities.Menu>? menus = null;
    try
    {
        menus = await Db.Menus
            .Where(m => m.IsActive)
            .OrderBy(m => m.Weight)
            .ToListAsync();
    }
    catch (Exception)
    {
        // If database is not reachable, fall back to defaults
        menus = new List<Authenticate.Data.Entities.Menu>();
    }

    var leftMenus = menus?.Where(m => m.Weight <= 0).OrderBy(m => m.Weight).ToList() ?? new List<Authenticate.Data.Entities.Menu>();
    var rightMenus = menus?.Where(m => m.Weight > 0).OrderBy(m => m.Weight).ToList() ?? new List<Authenticate.Data.Entities.Menu>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MyApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">MyApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                @if (menus != null && menus.Count > 0)
                {
                    <ul class="navbar-nav me-auto">
                        @foreach (var item in leftMenus)
                        {
                            <li class="nav-item"><a class="nav-link" href="@item.Target">@item.Name</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @foreach (var item in rightMenus)
                        {
                            <li class="nav-item"><a class="nav-link" href="@item.Target">@item.Name</a></li>
                        }
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="/Account/Login">Login</a></li>
                    </ul>
                }
            </div>
        </div>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="bg-light text-center py-3 mt-4">
        <span class="text-muted">&copy; @DateTime.Now.Year - MyApp</span>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>